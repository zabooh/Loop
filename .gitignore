# --- Build output / intermediates (regenerated by build.bat) ---
/_build/
/out/

# --- Python ---
__pycache__/
*.pyc

# --- Logic-analyzer raw captures (regenerated by the test tools) ---
/smoketest_csv/
/freq_sweep_cap/
/duty_sweep_cap/

# --- Logs / scratch ---
/queuelogs/
_*.txt

.generated_files/
build/
dist/
nbproject/
Makefile*
Package-*
private/
_build/
!cmake/**/user.cmake
cmake/**/.generated/*
cmake/**/CMake*
out/

# --- Keep the CMake project files in the repo so a fresh clone builds from the
#     command line (overrides the MPLAB ignore rules above). Note: the generated
#     toolchain.cmake hardcodes the absolute XC8 path of this machine. ---
!cmake/**/.generated/*
!cmake/**/CMakeLists.txt
!cmake/**/CMakePresets.json